[resource]
script = ExtResource("5_pj32s")
id = "us_m4a3_75w_vvss_1944"
historical_identity_id = "us_m4a3_75w_vvss_1944"
content_tier = "research"
display_name = "M4A3 (75) W Sherman - 1944 reference configuration (VVSS, wet stowage)"
parts = Array[ExtResource("4_eq1du")]([SubResource("Resource_ttxta"), SubResource("Resource_hu6v0"), SubResource("Resource_vb1i4")])
armor_patches = Array[ExtResource("1_tbhn2")]([SubResource("Resource_eim6v"), SubResource("Resource_oirtx"), SubResource("Resource_dr7o0"), SubResource("Resource_7tbtr"), SubResource("Resource_qlet2"), SubResource("Resource_x7em1"), SubResource("Resource_w6jto"), SubResource("Resource_rt434"), SubResource("Resource_0yg2i"), SubResource("Resource_ttg6q"), SubResource("Resource_id25n"), SubResource("Resource_22lyf")])
modules = Array[ExtResource("3_sfq0u")]([SubResource("Resource_1cyrs"), SubResource("Resource_ithf7"), SubResource("Resource_dg5s0"), SubResource("Resource_0lvw7"), SubResource("Resource_goid7"), SubResource("Resource_grr2c"), SubResource("Resource_f2p0o"), SubResource("Resource_0qq3n"), SubResource("Resource_i3cst"), SubResource("Resource_ayfab"), SubResource("Resource_c18ys"), SubResource("Resource_hdgvc"), SubResource("Resource_r47v5"), SubResource("Resource_i457o")])
crew_stations = Array[ExtResource("2_mlhe5")]([SubResource("Resource_0tnrx"), SubResource("Resource_nuqr7"), SubResource("Resource_2efm6"), SubResource("Resource_sevaq"), SubResource("Resource_fh1hd")])
source_catalog_id = "SRC-TM9-759"
field_evidence_id = "FIELD-EVIDENCE-US-M4A3-75W-1944"
declared_openings = Array[Dictionary]([{
"boundary_loop": [Vector3(-0.95, 1.72, 0.95), Vector3(0.95, 1.72, 0.95), Vector3(0.95, 1.72, -0.95), Vector3(-0.95, 1.72, -0.95)],
"id": "turret_ring",
"note": "turret ring opening in hull top plate (ring diameter unverified; square approximation of circular ring)",
"part": "hull"
}, {
"boundary_loop": [Vector3(-0.35, 0.07, -1.0852631), Vector3(-0.35, 0.57, -0.98), Vector3(0.35, 0.57, -0.98), Vector3(0.35, 0.07, -1.0852631)],
"id": "gun_mount_front",
"note": "gun mount opening in turret front (M34/M34A1 mount; shield split unmodeled)",
"part": "turret"
}, {
"boundary_loop": [Vector3(-0.9, 0, -1.1), Vector3(-0.9, 0, 0.9), Vector3(0.9, 0, 0.9), Vector3(0.9, 0, -1.1)],
"id": "turret_bottom_ring",
"note": "turret shell bottom edge where shell meets hull top plate at the ring (turret shell has no floor plate of its own; 75mm wet stowage has full turret floor bracket-mounted inside)",
"part": "turret"
}])
allowed_overlaps = Array[Dictionary]([{
"a": "fuel_tank",
"b": "engine_main",
"reason": "fuel tank at rear area adjacent to engine compartment; wet-stowage tank position estimated (capacity 168 gal verified only)"
}])
