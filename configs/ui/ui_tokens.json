{
  "schema_version": 1,
  "design_id": "MCT-UI-FIELDWORK-01",
  "version": "1.0",
  "status": "design_proposal_not_installed",
  "colors": {
    "background": "#10171B",
    "surface": "#182329",
    "surface_raised": "#223139",
    "border_decorative": "#35464E",
    "control_outline": "#697F88",
    "text_primary": "#ECEDE6",
    "text_secondary": "#A8B6BA",
    "accent": "#E0B46A",
    "on_accent": "#141A1E",
    "ally": "#7FC9E0",
    "enemy": "#F17C72",
    "warning": "#E8BE70",
    "critical": "#FF8A80",
    "positive": "#A0CBA1",
    "disabled_text": "#83969D",
    "focus": "#E0B46A"
  },
  "font": {
    "source": "reuse existing licensed project CJK font; no font binary in this design package",
    "sizes_at_ui_scale_1": {
      "vehicle_title": 34,
      "page_title": 28,
      "section": 20,
      "body": 16,
      "button": 16,
      "secondary": 14,
      "hud_number": 24,
      "critical_notice": 18
    },
    "body_line_height_ratio": 1.35,
    "ui_scale_first_delivery": [
      1.0,
      1.25
    ],
    "apply_scale_once": true
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "components": {
    "radius": 4,
    "border": 1,
    "focus_border": 2,
    "primary_button_min_height": 48,
    "button_min_height": 40,
    "icon_hitbox_min": [
      40,
      40
    ],
    "panel_padding": 16,
    "modal_max_height_rule": "available_viewport_height - 2*safe_margin"
  },
  "layouts": {
    "coordinate_system": "effective UI logical space after existing canvas transform; not raw OS pixels",
    "wide": {
      "minimum_width": 1600,
      "minimum_height": 900,
      "outer_margin": 32,
      "sidebar": 344,
      "gap": 24
    },
    "standard": {
      "minimum_width": 1360,
      "minimum_height": 760,
      "outer_margin": 24,
      "sidebar": 320,
      "gap": 16
    },
    "compact": {
      "outer_margin": 16,
      "sidebar": 296,
      "gap": 12
    },
    "menu_max_width": 1920,
    "hud_clear_region_normalized": {
      "x_min": 0.25,
      "x_max": 0.75,
      "y_min": 0.2,
      "y_max": 0.7,
      "exempt": [
        "reticle",
        "essential short transient message"
      ]
    },
    "hud_wide": {
      "objective": [
        640,
        64
      ],
      "own_vehicle": [
        280,
        184
      ],
      "ammo": [
        360,
        104
      ],
      "minimap": [
        224,
        224
      ]
    },
    "hud_compact": {
      "objective": [
        480,
        56
      ],
      "own_vehicle": [
        224,
        144
      ],
      "ammo": [
        288,
        96
      ],
      "minimap": [
        168,
        168
      ]
    }
  },
  "motion_ms": {
    "hover": 100,
    "page": 160,
    "drawer": 180,
    "toast": 160,
    "tooltip_delay": 350
  },
  "contrast_targets": {
    "readable_text": 4.5,
    "essential_non_text": 3.0,
    "high_contrast_body": 7.0,
    "claim": "design target; not WCAG conformance certification"
  },
  "forbidden_static_mock_values": [
    "money balances",
    "battle ratings",
    "power scores",
    "network player availability",
    "fake historical performance",
    "unsupported battle capacity"
  ],
  "performance_policy": "HOLD_BY_USER; no benchmarking or claimed FPS improvement"
}
